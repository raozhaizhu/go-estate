ENVIRONMENT=development
SERVER_PORT=8080
TOKEN_SYMMETRIC_KEY=12345678901234597890123456789019
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# 数据库设定
DB_SOURCE=root:123456@tcp(127.0.0.1:3306)/go_estate?parseTime=true
DB_CONTAINER=mysql
DB_NAME=go_estate
DB_USER=root
DB_PASSWORD=123456
DB_URL=mysql://root:123456@tcp(127.0.0.1:3306)/go_estate?parseTime=true

# Redis设定, 本地单元测试需要, 因此用127.0.0.1:
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=123456

MIGRATION_URL=file://dao/migration
CHARSET=--default-character-set=utf8mb4

# Path
PROJECT_PATH=github.com/raozhaizhu/go-estate
PROJECT_INTERNAL_PATH=github.com/raozhaizhu/go-estate/internal

DAILY_DATA_CONTROLLER_PATH=github.com/raozhaizhu/go-estate/internal/controller/daily_data
USER_CONTROLLER_PATH=github.com/raozhaizhu/go-estate/internal/controller/user
AUTH_CONTROLLER_PATH=github.com/raozhaizhu/go-estate/internal/controller/auth

MAKER_PATH=github.com/raozhaizhu/go-estate/pkg/token

# Dir
DB_DIR=./internal/dao
DB_SQLC_DIR=./internal/dao/sqlc
PKG_DIR=./pkg

DAILY_DATA_CONTROLLER_DIR=./internal/controller/daily_data
USER_CONTROLLER_DIR=./internal/controller/user
AUTH_CONTROLLER_DIR=./internal/controller/auth

SESSION_SERVICE_DIR=./internal/service/auth

# ObjectStore
OSS_DOMAIN=http://localhost:9000/
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_ID=admin
MINIO_SECRET_ACCESS_KEY=12345678
